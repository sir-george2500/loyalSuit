# PostgreSQL (Supabase)
POSTGRES_HOST=db.your-project.supabase.co
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password

# Redis (RedisLabs)
REDIS_HOST=your-redis-host.redislabs.com
REDIS_PORT=12345
REDIS_USER=default
REDIS_PASSWORD=your-redis-password

# Self-contained auth — the platform signs its own JWTs (no external auth provider)
APP_JWT_SECRET=use-a-long-random-string-at-least-32-characters
APP_JWT_EXPIRATION=86400

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# App
APP_BASE_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# Email (SMTP) — transactional mail (onboarding welcome, password reset).
# For Gmail use an App Password, not your account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_STARTTLS=true
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-app-password
EMAIL_FROM=no-reply@yourdomain.com
EMAIL_FROM_NAME=LoyalSuit
