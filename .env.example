# Root environment for `docker compose` (production-like run). Copy to `.env` and fill in.
# Postgres and Redis are managed externally (Supabase / RedisLabs in the reference setup).

# --- Database (Postgres) ---
POSTGRES_HOST=db.your-project.supabase.co
POSTGRES_DATABASE=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# --- Cache (Redis) ---
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=change-me

# --- Auth (self-issued JWT) ---
APP_JWT_SECRET=use-a-long-random-string-at-least-32-characters
APP_JWT_EXPIRATION=86400

# --- URLs ---
APP_BASE_URL=https://api.your-domain.com
FRONTEND_URL=https://your-domain.com
# Baked into the browser bundle at build time — must be the PUBLIC backend URL.
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# --- Email (SMTP, optional; sending is best-effort) ---
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password
EMAIL_FROM=no-reply@your-domain.com
EMAIL_FROM_NAME=LoyalSuit

# --- Rate limiting (10a; defaults are sensible) ---
RATE_LIMIT_ENABLED=true

# --- Error tracking (Sentry, optional; disabled when DSN is blank) ---
SENTRY_DSN=
SENTRY_ENV=production
SENTRY_TRACES_RATE=0.1
